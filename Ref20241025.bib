@article{dongFlexibleEcoCruisingStrategyConnected2024a,
  title = {Flexible {{Eco-Cruising Strategy}} for {{Connected}} and {{Automated Vehicles}} with {{Efficient Driving Lane Planning}} and {{Speed Optimization}}},
  author = {Dong, Haoxuan and Wang, Qun and Zhuang, Weichao and Yin, Guodong and Gao, Kun and Li, Zhaojian and Song, Ziyou},
