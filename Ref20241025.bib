@article{wangModellingSupportedDrivingOptimal2013,
  title = {Modelling Supported Driving as an Optimal Control Cycle: {{Framework}} and Model Characteristics},
  author = {Wang, Meng and Treiber, Martin and Daamen, Winnie and Hoogendoorn, Serge P. and {van Arem}, Bart},
  year = {2013},
  month = nov,
  journal = {Transportation Research Part C-Emerging Technologies},
  volume = {36},
  pages = {547--563},
  issn = {0968-090X},
  doi = {10.1016/j.trc.2013.06.012},
  abstract = {Driver assistance systems support drivers in operating vehicles in a safe, comfortable and efficient way, and thus may induce changes in traffic flow characteristics. This paper puts forward a receding horizon control framework to model driver assistance and cooperative systems. The accelerations of automated vehicles are controlled to optimise a cost function, assuming other vehicles driving at stationary conditions over a prediction horizon. The flexibility of the framework is demonstrated with controller design of Adaptive Cruise Control (ACC) and Cooperative ACC (C-ACC) systems. The proposed ACC and C-ACC model characteristics are investigated analytically, with focus on equilibrium solutions and stability properties. The proposed ACC model produces plausible human car-following behaviour and is unconditionally locally stable. By careful tuning of parameters, the ACC model generates similar stability characteristics as human driver models. The proposed C-ACC model results in convective downstream and absolute string instability, but not convective upstream string instability observed in human-driven traffic and in the ACC model. The control framework and analytical results provide insights into the influences of ACC and C-ACC systems on traffic flow operations. (C) 2013 Elsevier Ltd. All rights reserved.},
  langid = {english},
  keywords = {Advanced Driver Assistance Systems,Car-following,Cooperative systems,Optimal control,Stability analysis},
  annotation = {32 citations (Crossref) [2024-09-20]},
  file = {D:\Software\ZoteroFile\storage\KI4NTMT3\Wang 等 - 2013 - Modelling supported driving as an optimal control .pdf}
}

@article{zhengEmpiricalExperimentalStudyGrowth2022,
  title = {Empirical and Experimental Study on the Growth Pattern of Traffic Oscillations Upstream of Fixed Bottleneck and Model Test},
  author = {Zheng, Shi-Teng and Jiang, Rui and Tian, Junfang and Li, Xiaopeng and Treiber, Martin and Li, Zhen-Hua and Gao, Lan-Da and Jia, Bin},
  year = {2022},
  month = jul,
  journal = {Transportation Research Part C: Emerging Technologies},
  volume = {140},
  pages = {103729},
  issn = {0968090X},
  doi = {10.1016/j.trc.2022.103729},
  urldate = {2022-08-26},
  abstract = {This paper aims to address a simple but fundamental question, how the traffic oscillations grow along the road. Firstly, we conduct an empirical study on the growth pattern of traffic oscillations on US-101 Freeway and German-A5 Freeway. Then we perform an experiment to study the growth pattern of traffic oscillations on a single lane with a fixed bottleneck of speed limit. Both empirical and experimental results show that traffic oscillations grow in a concave way along the road. This finding is consistent with the previous one that traffic oscillations grow concavely along the platoon following a slower leader taking on the role of a moving bottleneck, which is not to be expected a priori for a fixed bottleneck. Finally, we use the finding to test three typical car-following models. The test indicates that whereas the intelligent driver model (IDM) fails to reproduce the observed growth pattern, the 2D-IDM and the stochastic speed adaptation model could. These findings are expected to improve our understanding of the role of stochasticity in car following, and the high-quality data in itself can be used to test traffic flow models and theories.},
  langid = {english},
  annotation = {10 citations (Crossref) [2024-06-25]\\
abstractTranslation:  本文旨在解决一个简单但基本的问题，即道路上的交通波动如何增长。首先，我们对US-101高速公路和德国A5高速公路的交通波动增长模式进行了实证研究。然后我们进行了一个实验来研究具有固定限速瓶颈的单车道上交通振荡的增长模式。实证和实验结果都表明，交通振荡沿道路呈凹形增长。这一发现与前一个发现一致，即在较慢的领导者扮演移动瓶颈的角色之后，流量振荡沿着排凹地增长，这对于固定瓶颈来说是不可预见的。最后，我们利用这一发现来测试三种典型的跟车模型。测试表明，虽然智能驾驶员模型 (IDM) 无法重现观察到的生长模式，但 2D-IDM 和随机速度适应模型可以。这些发现有望提高我们对随机性在跟车中的作用的理解，并且高质量数据本身可以用来测试交通流模型和理论。\\
titleTranslation: 固定瓶颈上游交通振荡增长规律的实证与实验研究及模型检验},
  file = {D:\Software\ZoteroFile\storage\XIJ5ME24\Zheng 等。 - 2022 - Empirical and experimental study on the growth pat.pdf}
}

