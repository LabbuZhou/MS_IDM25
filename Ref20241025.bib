@article{tianImproved2DIntelligentDriver2016,
  title = {Improved {{2D}} Intelligent Driver Model in the Framework of Three-Phase Traffic Theory Simulating Synchronized Flow and Concave Growth Pattern of Traffic Oscillations},
  author = {Tian, Junfang and Jiang, Rui and Li, Geng and Treiber, Martin and Jia, Bin and Zhu, Chenqiang},
  year = {2016},
  month = aug,
  journal = {Transportation Research Part F: Traffic Psychology and Behaviour},
  volume = {41},
  pages = {55--65},
  issn = {13698478},
  doi = {10.1016/j.trf.2016.06.005},
  urldate = {2022-03-13},
  abstract = {This paper firstly show that 2 Dimensional Intelligent Driver Model (Jiang et al., 2014) is not able to replicate the synchronized traffic flow. Then we propose an improved model by considering the difference between the driving behaviors at high speeds and that at low speeds, which is in the framework of three-phase traffic theory. Simulations show that the improved model can reproduce the phase transition from synchronized flow to wide moving jams, the spatiotemporal patterns of traffic flow induced by traffic bottleneck, and the concave growth pattern of traffic oscillations (i.e. the standard deviation of the velocities of vehicles increases in a concave/linear way along the platoon). Validating results show that the empirical time series of traffic speed obtained from Floating Car Data can be well simulated as well.},
  langid = {english},
  annotation = {46 citations (Crossref) [2024-06-25]\\
abstractTranslation:  本文首先表明二维智能驾驶员模型（Jiang et al., 2014）无法复制同步交通流。然后，我们在三相交通理论的框架下，考虑高速和低速驾驶行为的差异，提出了一种改进模型。仿真表明，改进的模型可以再现从同步流到宽移动拥堵的相变、交通瓶颈引起的交通流时空模式以及交通振荡的凹增长模式（即车辆速度的标准差在沿排的凹/线性方式）。验证结果表明，从浮动车数据获得的交通速度经验时间序列也可以很好地模拟。\\
titleTranslation: 三相交通理论框架下改进的二维智能驾驶员模型模拟同步流和交通波动的凹增长模式},
  file = {D:\Software\ZoteroFile\storage\AWW9U56Z\Tian 等。 - 2016 - Improved 2D intelligent driver model in the framew.pdf}
}

@article{tianMicroscopicDrivingTheoryOscillatory2015,
  title = {Microscopic Driving Theory with Oscillatory Congested States: {{Model}} and Empirical Verification},
  shorttitle = {Microscopic Driving Theory with Oscillatory Congested States},
  author = {Tian, Junfang and Treiber, Martin and Ma, Shoufeng and Jia, Bin and Zhang, Wenyi},
  year = {2015},
  month = jan,
  journal = {Transportation Research Part B: Methodological},
  volume = {71},
  pages = {138--157},
  issn = {01912615},
  doi = {10.1016/j.trb.2014.11.003},
  urldate = {2022-03-13},
  abstract = {The essential distinction between the Fundamental Diagram Approach (FDA) and Kerner's three-phase theory (KTPT) is the existence of a unique gap--speed (or flow--density) relationship in the former class. In order to verify this relationship, empirical data are analyzed with the following findings: (1) linear relationship between the actual space gap and speed can be identified when the speed difference between vehicles approximates zero; (2) vehicles accelerate or decelerate around the desired space gap most of the time. To explain these phenomena, we propose that, in congested traffic flow, the space gap between two vehicles will oscillate around the desired space gap in the deterministic limit. This assumption is formulated in terms of a cellular automaton. In contrast to FDA and KTPT, the new model does not have any congested steady-state solution. Simulations under periodic and open boundary conditions reproduce the empirical findings of KTPT. Calibrating and validating the model to detector data produces results that are better than that of previous studies.},
  langid = {english},
  annotation = {72 citations (Crossref) [2024-06-25]\\
abstractTranslation:  基本图方法 (FDA) 和克纳三相理论 (KTPT) 之间的本质区别在于，前者存在独特的间隙-速度（或流量-密度）关系。为了验证这种关系，对经验数据进行了分析，得到以下结论：（1）当车辆之间的速度差接近于零时，可以识别实际空间间隙与速度之间的线性关系； (2)车辆大部分时间围绕所需的空间间隙加速或减速。为了解释这些现象，我们提出，在拥堵的交通流中，两辆车之间的空间间隙将在确定性极限内的所需空间间隙周围振荡。该假设是根据元胞自动机来表述的。与 FDA 和 KTPT 相比，新模型没有任何拥塞稳态解决方案。周期性和开放边界条件下的模拟再现了 KTPT 的经验结果。根据探测器数据校准和验证模型产生的结果优于之前的研究。\\
titleTranslation: 振荡拥塞态的微观驱动理论：模型和经验验证},
  file = {D:\Software\ZoteroFile\storage\RBNF69H9\Tian 等。 - 2015 - Microscopic driving theory with oscillatory conges.pdf}
}





@article{tianReviewCellularAutomataModels2021,
  title = {Review of the Cellular Automata Models for Reproducing Synchronized Traffic Flow},
  author = {Tian, Junfang and Zhu, Chenqiang and Jiang, Rui and Treiber, Martin},
  year = {2021},
  month = dec,
  journal = {Transportmetrica a: Transport Science},
  volume = {17},
  number = {4},
  pages = {766--800},
  issn = {2324-9935, 2324-9943},
  doi = {10.1080/23249935.2020.1810820},
  urldate = {2021-10-05},
  abstract = {Cellular automaton (CA) approach is an important theoretical framework for studying complex system behavior and has been widely applied in various research field. CA traffic flow models have the advantage of flexible evolution rules and high computation efficiency. Therefore, CA develops very quickly and has been widely applied in transportation field. In recent two decades, traffic flow study quickly developed, among which 'synchronized flow' is perhaps one of the most important concepts and findings. Many new CA models have been proposed in this direction. This paper makes a review of the development of CA models, concerning their ability to reproduce synchronized flow as well as traffic breakdown from free flow to synchronized flow. Finally, future directions have been discussed.},
