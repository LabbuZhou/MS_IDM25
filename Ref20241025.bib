@article{awal_fault_2022,
  title = {Fault Tolerance Analysis of Car-Following Models for Autonomous Vehicles},
  author = {Awal, Tanveer and Mushfiq, Md Masum and Al Islam, A. B. M. Alim},
  year = {2022},
  month = nov,
  journal = {IEEE Transactions on Intelligent Transportation Systems},
  volume = {23},
