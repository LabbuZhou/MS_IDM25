@article{treiberEvidenceConvectiveInstabilityCongested2011,
  title = {Evidence of {{Convective Instability}} in {{Congested Traffic Flow}}: {{A Systematic Empirical}} and {{Theoretical Investigation}}},
  shorttitle = {Evidence of {{Convective Instability}} in {{Congested Traffic Flow}}},
  author = {Treiber, Martin and Kesting, Arne},
  year = {2011},
  journal = {Procedia - Social and Behavioral Sciences},
  volume = {17},
  pages = {683--701},
  issn = {18770428},
  doi = {10.1016/j.sbspro.2011.04.539},
  urldate = {2021-12-21},
  abstract = {An extended open system such as traffic flow is said to be convectively unstable if perturbations of the stationary state grow but propagate in only one direction, so they eventually leave the system. By means of data analysis, simulations, and analytical calculations, we give evidence that this concept is relevant for instabilities of congested traffic flow. We analyze detector data from several hundred traffic jams and propose estimates for the linear growth rate, the wavelength, the propagation velocity, and the severity of the associated bottleneck that can be evaluated semi-automatically. Scatter plots of these quantities reveal systematic dependencies. On the theoretical side, we derive, for a wide class of microscopic and macroscopic traffic models, analytical criteria for convective and absolute linear instabilities. Based on the relative positions of the stability limits in the fundamental diagram, we divide these models into five stability classes which uniquely determine the set of possible elementary spatiotemporal patterns in open systems with a bottleneck. Only two classes, both dominated by convective instabilities, are compatible with observations. By means of approximate solutions of convectively unstable systems with sustained localized noise, we show that the observed spatiotemporal phenomena can also be described analytically. The parameters of the analytical expressions can be inferred from observations, and also (analytically) derived from the model equations.},
  langid = {english},
  annotation = {15 citations (Crossref) [2024-06-25]\\
abstractTranslation:  如果静止状态的扰动增长但仅沿一个方向传播，那么诸如交通流之类的扩展开放系统就被认为是对流不稳定的，因此它们最终会离开系统。通过数据分析、模拟和分析计算，我们证明这一概念与拥堵交通流的不稳定性有关。我们分析了数百个交通拥堵的探测器数据，并提出了对线性增长率、波长、传播速度以及可以半自动评估的相关瓶颈严重程度的估计。这些数量的散点图揭示了系统依赖性。在理论方面，我们针对各种微观和宏观交通模型推导了对流和绝对线性不稳定性的分析标准。根据基本图中稳定性极限的相对位置，我们将这些模型分为五个稳定性类别，它们唯一地确定了具有瓶颈的开放系统中可能的基本时空模式集。只有两类（均以对流不稳定性为主）与观测结果相符。通过具有持续局部噪声的对流不稳定系统的近似解，我们表明观察到的时空现象也可以通过分析来描述。解析表达式的参数可以从观察中推断出来，也可以从模型方程（解析地）导出。\\
titleTranslation: 拥堵交通流中对流不稳定的证据：系统的实证和理论研究},
  file = {D:\Software\ZoteroFile\storage\DFIUWY6A\Treiber 和 Kesting - 2011 - Evidence of Convective Instability in Congested Tr.pdf}
}

