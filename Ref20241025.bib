}

@article{tang_grounded_2024,
  title = {Grounded Relational Inference: {{Domain}} Knowledge Driven Explainable Autonomous Driving},
  author = {Tang, Chen and Srishankar, Nishan and Martin, Sujitha and Tomizuka, Masayoshi},
  year = {2024},
