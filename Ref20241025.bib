}

@article{cao_gain_2022,
  title = {A {{Gain}} with {{No Pain}}: {{Exploring Intelligent Traffic Signal Control}} for {{Emergency Vehicles}}},
  author = {Cao, Miaomiao and Li, Victor O. K. and Shuai, Qiqi},
  year = {2022},
