  issn = {0968090X},
  doi = {10.1016/j.trc.2024.104486},
  urldate = {2024-04-19},
  abstract = {One of the biggest challenges in the development of learning-driven automated driving technologies remains the handling of uncommon, rare events that may have not been encountered in training. Especially when training a model with real driving data, unusual situations, such as emergency brakings, may be underrepresented, resulting in a model that lacks robustness in rare events. This study focuses on car-following based on reinforcement learning and demonstrates that existing approaches, trained with real driving data, fail to handle safety--critical situations. Since collecting data representing all kinds of possible car-following events, including safety--critical situations, is challenging, we propose a training environment that harnesses stochastic processes to generate diverse and challenging scenarios.},
