}

@article{ito_coordination_2019,
  title = {Coordination of Connected Vehicles on Merging Roads Using Pseudo-Perturbation-Based Broadcast Control},
  author = {Ito, Yuji and Kamal, Md Abdus Samad and Yoshimura, Takayoshi and Azuma, Shun-ichi},
  year = {2019},
