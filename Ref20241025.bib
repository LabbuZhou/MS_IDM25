@article{duCoupledVehicleSignalControlMethod2021b,
  title = {A {{Coupled Vehicle-Signal Control Method}} at {{Signalized Intersections}} in {{Mixed Traffic Environment}}},
  author = {Du, Yu and ShangGuan, Wei and Chai, Linguo},
