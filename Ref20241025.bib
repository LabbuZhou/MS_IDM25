@article{zhangSimultaneousModelingCarFollowingLaneChanging2019c,
  title = {Simultaneous {{Modeling}} of {{Car-Following}} and {{Lane-Changing Behaviors Using Deep Learning}}},
  author = {Zhang, Xiaohui and Sun, Jie and Qi, Xiao and Sun, Jian},
  year = {2019},
