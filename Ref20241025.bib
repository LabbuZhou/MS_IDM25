}

@article{zheng_cooperative_2020,
  title = {Cooperative {{Lane Changing Strategies}} to {{Improve Traffic Operation}} and {{Safety Nearby Freeway Off-Ramps}} in a {{Connected}} and {{Automated Vehicles Environment}}},
  author = {Zheng, Yuan and Ran, Bin and Qu, Xu and Zhang, Jian and Lin, Yi},
  year = {2020},
