@article{li_deep_2022,
  title = {Deep {{Reinforcement Learning}} and {{Reward Shaping Based Eco-Driving Control}} for {{Automated HEVs}} among {{Signalized Intersections}}},
  author = {Li, Jie and Wu, Xiaodong and Xu, Min and Liu, Yonggang},
  year = {2022},
