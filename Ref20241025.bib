}

@article{li_hopf_2023,
  title = {Hopf Bifurcation Analysis of Mixed Traffic and Its Implications for Connected and Autonomous Vehicles},
  author = {Li, Tenglong and Ngoduy, Dong and Zhao, Xiangmo},
