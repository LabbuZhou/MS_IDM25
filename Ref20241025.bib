@article{chen_human-like_2023,
  title = {Human-like Control for Automated Vehicles and Avoiding ``Vehicle Face-off'' in Unprotected Left Turn Scenarios},
  author = {Chen, Jin and Sun, Dihua and Zhao, Min},
