@article{kangTrajectoryBasedEmbeddingRandomCoefficients2023b,
  title = {Trajectory-{{Based Embedding}} for {{Random Coefficients}} of a {{Theory-Based Car-Following Model}}},
  author = {Kang, Yeseul and Kim, Gyeongjun and Jeong, Seungyun and Sohn, Keemin},
