@article{shiConnectedAutomatedVehicleCooperative2021b,
  title = {Connected {{Automated Vehicle Cooperative Control}} with a {{Deep Reinforcement Learning Approach}} in a {{Mixed Traffic Environment}}},
  author = {Shi, Haotian and Zhou, Yang and Wu, Keshu and Wang, Xin and Lin, Yangxin and Ran, Bin},
