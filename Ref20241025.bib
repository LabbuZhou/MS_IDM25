@article{wang_emission_2015,
  title = {Emission {{Mitigation}} via {{Longitudinal Control}} of {{Intelligent Vehicles}} in a {{Congested Platoon}}},
  author = {Wang, Zhaodong and Chen, Xiqun (Michael) and Ouyang, Yanfeng and Li, Meng},
