}

@article{maProgressiveVirtualRiskBasedVehicle2024a,
  title = {Progressive {{Virtual Risk-Based Vehicle Trajectory Optimization}} in {{Mixed Traffic Flow}}},
  author = {Ma, Haozhan and Qian, Chen and Li, Linheng and Qu, Xu and Ran, Bin},
